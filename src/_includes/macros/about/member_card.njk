{% macro member_card(member) %}
  <div class="team-card">
    <div
      class="team-avatar"
      style="overflow: hidden; border-color: var(--color-teal);"
    >
      <img
        src="/images/members/{{ member.img }}"
        alt="{{ member.name }}"
        style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;"
      />
    </div>
    <h4>{{ member.name }}</h4>
    <div class="team-role">{{ member.role }}</div>
    <p style="font-size: 0.9rem;">
      {{ member.description }}
    </p>
  </div>
{% endmacro %}
