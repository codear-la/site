<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Brand/logo section -->
    <div class="footer-brand">
      <img
        src="/images/logo.svg"
        alt="codear.la logo"
        class="footer-logo"
        width="215"
        height="52"
      />
      <p class="footer-desc">{{ texts.footer.desc }}</p>
    </div>

    <!-- Quick Links -->
    <div class="footer-links">
      <h4>{{ texts.footer.links_title }}</h4>
      <ul>
        {% for link in config.nav_links.navigation %}
          <li>
            <a href="{{ routes[lang][link] }}" class="footer-link-item">{{
              texts.header.nav[link]
            }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <!-- Contact Information -->
    <div class="footer-contact">
      <h4>{{ texts.footer.contact_title }}</h4>
      <div class="footer-contact-list">
        <div class="footer-contact-item">
          <!-- Email Icon (SVG) -->
          {% include helpers.icons.email %}
          <span>{{ config.contact.email }}</span>
        </div>
        <div class="footer-contact-item">
          <!-- Phone Icon (SVG) -->
          {% include helpers.icons.phone %}
          <span>{{ config.contact.phone }}</span>
        </div>
        <div class="footer-contact-item">
          <!-- Map Icon (SVG) -->
          {% include helpers.icons.map_pin %}
          <span>{{ config.contact.address }}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <div class="footer-copy">
      {{ texts.footer.rights }}
    </div>
    <!-- Social Media Links -->
    <div class="social-links">
      {% for social in config.nav_links.social %}
        {% if social.active %}
          <a
            href="{{ social.href }}"
            class="social-btn"
            aria-label="{{ social.name }}"
          >
            {% include helpers.icons[social.id] %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</footer>
