<header class="site-header">
  <div class="container header-container">
    <!-- Logo linked to home in the current language -->
    <a
      href="{{ routes[lang].home }}"
      class="site-logo"
      aria-label="{{ texts.header.logo.aria_label }}"
    >
      <img
        src="/images/logo.svg"
        alt="{{ texts.header.logo.alt }}"
        width="215"
        height="52"
      />
    </a>

    <!-- Checkbox to control mobile menu via CSS -->
    <input type="checkbox" id="nav-checkbox" />
    <label
      for="nav-checkbox"
      class="menu-toggle"
      aria-label="{{ texts.header.menu.toggle_aria_label }}"
    >
      <span></span>
      <span></span>
      <span></span>
    </label>

    <!-- Navigation Menu -->
    <nav class="nav-menu">
      {% for link in config.nav_links.navigation %}
        <a
          href="{{ routes[lang][link] }}"
          class="nav-link {% if pageId == link %}active{% endif %}"
        >
          {{ texts.header.nav[link] }}
        </a>
      {% endfor %}

      <!-- Language Selector -->
      <div class="lang-selector">
        {% for l in config.languages %}
          <a
            href="{{ routes[l][pageId] }}"
            class="lang-btn {% if lang == l %}active{% endif %}"
            title="{{ texts.header.nav.languages[l] }}"
          >{{ l }}</a>
        {% endfor %}
      </div>
    </nav>
  </div>
</header>
