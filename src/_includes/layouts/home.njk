---
layout: layouts/base.njk
---

<!-- Hero Section -->
<section class="section">
  <div class="container hero-wrapper">
    <div class="hero-content">
      <h1 class="text-navy">{{ texts[lang].pages.home.hero_title | safe }}</h1>
      <p class="hero-subtitle">{{ texts[lang].pages.home.hero_subtitle | safe }}</p>
      <div class="btn-group">
        <a href="{{ routes[lang].courses }}#chicos" class="btn btn-accent">{{ texts[lang].pages.home.hero_btn_kids }}</a>
        <a href="{{ routes[lang].courses }}#jovenes" class="btn btn-primary">{{ texts[lang].pages.home.hero_btn_teens }}</a>
        <a href="{{ routes[lang].courses }}#adultos" class="btn btn-secondary">{{ texts[lang].pages.home.hero_btn_adults }}</a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/images/robot-hero.svg" alt="Robot illustration" width="400" height="400" />
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="section section-alt">
  <div class="container">
    <div class="highlight-title">
      <h2>{{ texts[lang].pages.home.benefits_title }}</h2>
      <p style="max-width: 700px; margin: 15px auto 0; text-align: center;">{{ texts[lang].pages.home.benefits_subtitle | safe }}</p>
    </div>
    
    <div class="grid-3">
      <!-- Card 1 -->
      <div class="card">
        <div class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        </div>
        <h3>{{ texts[lang].pages.home.benefit1_title }}</h3>
        <p>{{ texts[lang].pages.home.benefit1_desc }}</p>
      </div>

      <!-- Card 2 -->
      <div class="card">
        <div class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="M12 6v6l4 2"></path></svg>
        </div>
        <h3>{{ texts[lang].pages.home.benefit2_title }}</h3>
        <p>{{ texts[lang].pages.home.benefit2_desc }}</p>
      </div>

      <!-- Card 3 -->
      <div class="card">
        <div class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <h3>{{ texts[lang].pages.home.benefit3_title }}</h3>
        <p>{{ texts[lang].pages.home.benefit3_desc }}</p>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action Section -->
<section class="section" style="background: linear-gradient(135deg, var(--color-navy), var(--color-navy-dark)); color: white;">
  <div class="container text-center">
    <h2 style="color: white; margin-bottom: 20px;">{{ texts[lang].pages.home.cta_title }}</h2>
    <p style="color: #94a3b8; max-width: 600px; margin: 0 auto 35px; font-size: 1.1rem;">{{ texts[lang].pages.home.cta_desc }}</p>
    <a href="{{ routes[lang].contact }}" class="btn btn-accent">{{ texts[lang].ui.contact_btn }}</a>
  </div>
</section>
