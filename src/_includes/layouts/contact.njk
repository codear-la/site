---
layout: layouts/base.njk
---

<section class="section">
  <div class="container">
    <div class="highlight-title">
      <h2>{{ texts[lang].pages.contact.subtitle }}</h2>
      <p style="max-width: 600px; margin: 15px auto 0; text-align: center;">{{ texts[lang].pages.contact.desc }}</p>
    </div>
    <div
      class="contact-wrapper">
      <!-- Contact Form -->
      <div class="contact-card">
        <form id="contact-form" action="#" method="POST">
          <div class="form-group-row">
            <div class="form-group">
              <label for="form-name" class="form-label">{{ texts[lang].ui.name }} *</label>
              <input type="text" id="form-name" class="form-input" placeholder="{{ texts[lang].pages.contact.placeholder_name }}" required/>
            </div>
            <div class="form-group">
              <label for="form-phone" class="form-label">{{ texts[lang].ui.phone }}</label>
              <input type="tel" id="form-phone" class="form-input" placeholder="{{ texts[lang].pages.contact.placeholder_phone }}"/>
            </div>
          </div>
          <div class="form-group">
            <label for="form-email" class="form-label">{{ texts[lang].ui.email }} *</label>
            <input type="email" id="form-email" class="form-input" placeholder="{{ texts[lang].pages.contact.placeholder_email }}" required/>
          </div>
          <div class="form-group">
            <label for="form-message" class="form-label">{{ texts[lang].ui.message }} *</label>
            <textarea id="form-message" class="form-input" placeholder="{{ texts[lang].pages.contact.placeholder_message }}" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%;">
            {{ texts[lang].ui.send }}
            <!-- Send Icon (SVG) -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewbox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>
      </div>
      <!-- Info Sidebar -->
      <div
        class="info-sidebar">
        <!-- Item 1: Email -->
        <div class="info-item-card">
          <div class="info-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewbox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="info-text">
            <h4>{{ texts[lang].pages.contact.sidebar_email_title }}</h4>
            <p>
              <a href="mailto:{{ texts[lang].pages.contact.email }}">{{ texts[lang].pages.contact.email }}</a>
            </p>
          </div>
        </div>
        <!-- Item 2: Phone -->
        <div class="info-item-card">
          <div class="info-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewbox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1
                4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1
                2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="info-text">
            <h4>{{ texts[lang].pages.contact.sidebar_phone_title }}</h4>
            <p>{{ texts[lang].pages.contact.sidebar_phone_hours }}<br><a href="{{ texts[lang].pages.contact.whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ texts[lang].pages.contact.phone }}</a>
            </p>
          </div>
        </div>
        <!-- Item 3: Mock map -->
        <div class="info-item-card" style="flex-direction: column;">
          <h4 class="text-navy" style="font-size: 1.1rem; margin-bottom: 10px;">{{ texts[lang].pages.contact.sidebar_map_title }}</h4>
          <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 15px;">{{ texts[lang].pages.contact.sidebar_map_desc }}</p>
          <!-- OpenStreetMap interactive map centered at Lugones 488, Quilmes -->
          <iframe
            width="100%"
            height="220"
            style="border: 0; border-radius: var(--border-radius-md); background-color: var(--color-teal-light);"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-58.2435%2C-34.73848%2C-58.2335%2C-34.73248&amp;layer=mapnik&amp;marker=-34.73548%2C-58.23850"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Success Modal (Pop-up) -->
<div id="success-modal" class="modal-overlay">
  <div class="modal-content">
    <div
      class="modal-icon">
      <!-- Check SVG Icon -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="36"
        height="36"
        viewbox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <h3 class="modal-title">{{ texts[lang].ui.success_title }}</h3>
    <p style="margin-bottom: 25px;">{{ texts[lang].ui.success_text }}</p>
    <button id="close-modal" class="btn btn-primary" style="width: 100%;">{{ texts[lang].pages.contact.modal_accept }}</button>
  </div>
</div>