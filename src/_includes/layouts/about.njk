---
layout: layouts/base.njk
---

<section class="section">
  <div class="container">
    <div class="highlight-title">
      <h2>{{ texts[lang].pages.about.subtitle }}</h2>
      <p style="max-width: 700px; margin: 15px auto 0; text-align: center;">{{ texts[lang].pages.about.mission }}</p>
    </div>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; margin-bottom: 70px;">
      <div>
        <h3 class="text-navy" style="margin-bottom: 15px;">{{ texts[lang].pages.about.history_title }}</h3>
        <p>{{ texts[lang].pages.about.history_p1 }}</p>
        <p>{{ texts[lang].pages.about.history_p2 }}</p>
      </div>
      <div style="background-color: var(--color-teal-light); border-radius: var(--border-radius-lg); padding: 40px; border: 1px
          dashed var(--color-teal);">
        <h3 class="text-teal" style="margin-bottom: 15px;">{{ texts[lang].pages.about.values_title }}</h3>
        <ul style="display: flex; flex-direction: column; gap: 15px;">
          <li style="display: flex; gap: 12px;">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewbox="0 0 24 24"
              fill="none"
              stroke="#13b1a4"
              stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>
              <strong>{{ texts[lang].pages.about.value1_bold }}</strong>
              {{ texts[lang].pages.about.value1_text }}</span>
          </li>
          <li style="display: flex; gap: 12px;">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewbox="0 0 24 24"
              fill="none"
              stroke="#13b1a4"
              stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>
              <strong>{{ texts[lang].pages.about.value2_bold }}</strong>
              {{ texts[lang].pages.about.value2_text }}</span>
          </li>
          <li style="display: flex; gap: 12px;">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewbox="0 0 24 24"
              fill="none"
              stroke="#13b1a4"
              stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>
              <strong>{{ texts[lang].pages.about.value3_bold }}</strong>
              {{ texts[lang].pages.about.value3_text }}</span>
          </li>
        </ul>
      </div>
    </div>
    <!-- Team Section -->
    <div class="highlight-title" style="margin-top: 80px;">
      <h2>{{ texts[lang].pages.about.team_title }}</h2>
      <p style="max-width: 600px; margin: 15px auto 0; text-align: center;">{{ texts[lang].pages.about.team_subtitle }}</p>
    </div>
    <div
      class="team-grid">
      <!-- Member 1 -->
      <div class="team-card">
        <div class="team-avatar" style="overflow: hidden; border-color: var(--color-teal);">
          <img src="/images/member1.jpg" alt="{{ texts[lang].pages.about.member1_name }}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;"/>
        </div>
        <h4>{{ texts[lang].pages.about.member1_name }}</h4>
        <div class="team-role">{{ texts[lang].pages.about.member1_role }}</div>
        <p style="font-size: 0.9rem;">{{ texts[lang].pages.about.member1_desc }}</p>
      </div>
      <!-- Member 2 -->
      <div class="team-card">
        <div class="team-avatar" style="overflow: hidden; border-color: var(--color-teal);">
          <img src="/images/member2.jpg" alt="{{ texts[lang].pages.about.member2_name }}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;"/>
        </div>
        <h4>{{ texts[lang].pages.about.member2_name }}</h4>
        <div class="team-role">{{ texts[lang].pages.about.member2_role }}</div>
        <p style="font-size: 0.9rem;">{{ texts[lang].pages.about.member2_desc }}</p>
      </div>
    </div>
  </div>
</section>